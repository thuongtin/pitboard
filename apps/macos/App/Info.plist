<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Pitboard</string>
	<key>CFBundleDisplayName</key>
	<string>Pitboard</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Drawn by scripts/make-icon.swift and put in the bundle by scripts/build-app.sh. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- scripts/build-app.sh sets both from the crate's version. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- A menu bar app: no Dock icon, no window at launch. -->
	<key>LSUIElement</key>
	<true/>
	<!-- A Pitboard link, pitboard://open?url=<a site's link>, which the Share extension
	     opens, shows the account picker. Pitboard defines the scheme, so its role is Editor.
	     The project sets the scheme per configuration: pitboard-debug in a debug build, so a
	     debug build never answers a link meant for an installed copy. A release build from a
	     branch claims pitboard like the installed copy, and is unregistered after building. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PITBOARD_URL_SCHEME)</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<!-- The same scheme, under the key the app and its Share extension both read it from. -->
	<key>PitboardURLScheme</key>
	<string>$(PITBOARD_URL_SCHEME)</string>
	<!-- What macOS shows if it asks before an account's window saves a download. -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Pitboard saves what you download in an account's window to your Downloads folder.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Pitboard opens Claude Code in Terminal with the Claude Desktop account you choose.</string>
</dict>
</plist>
